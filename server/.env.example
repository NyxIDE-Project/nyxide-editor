# Copy this file to .env and fill in real values. .env is gitignored.

# Cloudflare Turnstile - get real keys at https://dash.cloudflare.com/?to=/:account/turnstile
# The values below are Cloudflare's published *test* keypair: they always pass verification
# and work with no setup, but should never be used in production.
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Session cookie signing secret - set this to a long random string in production.
SESSION_SECRET=nyxide-dev-secret-change-me

# Comma-separated usernames to auto-promote to admin on startup.
ADMIN_USERNAMES=

# CHANGE THIS SO A RANDOM PERSON DOSN'T GET OWNER ACCESS!!!
OWNER_USERNAME=nyx

SERVER_PORT=8602

# Comma-separated origins allowed to make credentialed requests to this API.
CORS_ORIGINS=https://ide.nyxdev.app

# "Log in with Google" - get these from a project at https://console.cloud.google.com/.
# Leave blank to disable Google login (the button just won't work; nothing else breaks).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must exactly match an "Authorized redirect URI" configured for that Google client.
GOOGLE_REDIRECT_URI=https://nyxideapi.nyxdev.app/api/auth/google/callback
# Where to send the browser back to once a Google login finishes.
FRONTEND_URL=https://ide.nyxdev.app
