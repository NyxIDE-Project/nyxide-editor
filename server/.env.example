# Copy this file to .env and fill in real values. .env is gitignored.

# Cloudflare Turnstile - get real keys at https://dash.cloudflare.com/?to=/:account/turnstile
# The values below are Cloudflare's published *test* keypair: they always pass verification
# and work with no setup, but should never be used in production.
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Session cookie signing secret - set this to a long random string in production.
SESSION_SECRET=nyxide-dev-secret-change-me

# Comma-separated usernames to auto-promote to admin on startup.
ADMIN_USERNAMES=

# Username that always gets the owner role on startup.
OWNER_USERNAME=nyx

SERVER_PORT=8602
